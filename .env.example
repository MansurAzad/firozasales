SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_<key>"
# Legacy fallback for server-side auth middleware only.
# SUPABASE_ANON_KEY=""
SUPABASE_PROJECT_ID="<project-ref>"
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<key>"
# Legacy fallback only: use the project's anon JWT if the publishable key is unavailable.
# Do not set both VITE_SUPABASE_PUBLISHABLE_KEY and VITE_SUPABASE_ANON_KEY to different projects.
# VITE_SUPABASE_ANON_KEY=""
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Optional server-only key for privileged Auth administration.
SUPABASE_SERVICE_ROLE_KEY=""

# Required only for protected scheduled jobs, when configured.
SUPABASE_CRON_SECRET=""
SUPABASE_CRON_SECRET_PREVIOUS=""

# Local database connection string for Drizzle migrations. Never expose or commit.
SUPABASE_DB_MIGRATION_URL=""
